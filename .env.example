# ─────────────────────────────────────────────────────
#  SubZero — Environment Configuration Template
#  Copy this file to .env and fill in your keys.
#  NEVER commit your actual .env to git.
# ─────────────────────────────────────────────────────

# Meta Model API  (https://dev.meta.ai)
META_API_KEY="your-meta-model-api-key-here"
META_API_BASE_URL="https://api.meta.ai/v1"

# Baseten  (Muse Spark Open — use model ID: meta-models/muse-spark-open-1026)
BASETEN_API_KEY="your-baseten-api-key-here"
BASETEN_MODEL_ID="meta-models/muse-spark-open-1026"
BASETEN_API_BASE="https://model-<your-model-id>.api.baseten.co/production/predict"

# Modal  (Digital Twin Sandbox)
MODAL_TOKEN_ID="your-modal-token-id-here"
MODAL_TOKEN_SECRET="your-modal-token-secret-here"

# App Settings
PORT=8000
ENVIRONMENT=development
